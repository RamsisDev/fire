# Mutating HTTP endpoints require this token (X-FIRE-Token).
# Set locally; never commit a real value.
FIRE_API_TOKEN=

# Narrator (OpenAI-compatible). Never commit real keys.
FIRE_NARRATOR_BASE_URL=https://api.openai.com/v1
FIRE_NARRATOR_API_KEY=
FIRE_NARRATOR_MODEL=gpt-4.1-mini

# System One reasoner adapter over HTTP. Optional in v0 (echo stub).
# FIRE_SYSTEMONE_BASE_URL=http://127.0.0.1:8080/v1/systemone
# FIRE_SYSTEMONE_API_KEY=

# Catalog file, read when catalog.provider in config/fire.yml is sqlite, for example
# var/fire-catalog.sqlite3. Required by that provider; the memory provider ignores it.
FIRE_CATALOG_PATH=

# incident.io webhook (POST /v0/webhooks/incident-io): the endpoint's signing secret, whsec_...,
# from incident.io's Settings > Webhooks. Unset: the route answers 503. Never commit a real value.
FIRE_INCIDENT_IO_SIGNING_SECRET=

# Slack notifier (notifier.provider: slack in config/fire.yml): a bot token with chat:write,
# the bot invited to each system's notify.slack.channel_id. Required with slack; never commit it.
FIRE_SLACK_BOT_TOKEN=

# Tentacle (python -m fire.apps.tentacle): the body's base URL. It sends with FIRE_API_TOKEN.
FIRE_BODY_URL=http://127.0.0.1:8000

# Watched systems. Each config/systems/<system>.yml names its own env vars (*_env keys) for
# its manifest, sources, upstreams, and listen addresses; a real system's vars are listed here.
# Unset: the engine still starts and reports what is missing, and the tentacle skips that source
# and says so. AWS sources read the standard AWS environment (AWS_ENDPOINT_URL for a local
# emulator). The vars of config/systems/_template.yml, for a system copied from it:
# ACME_MANIFEST_PATH=
# ACME_OTLP_LISTEN=127.0.0.1:4318
# ACME_API_UPSTREAM=http://localhost:8080
# ACME_API_OPENAPI_PATH=
# ACME_PRICING_UPSTREAM=
# ACME_PRICING_OPENAPI_PATH=
# ACME_EVENTS_STREAM=
# ACME_EVENTS_TABLE=
# ACME_OUTBOX_TABLE=
# ACME_INVENTORY_UPDATES_STREAM=
# ACME_SHIPMENT_EVENTS_TOPIC=
# ACME_PAYMENT_EVENTS_TOPIC=
# ACME_CAPTURE_BUCKET=
# ACME_REPLAY_PATH=
